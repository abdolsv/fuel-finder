{
  "name": "fuel-finder-backend",
  "version": "1.0.0",
  "description": "SD-07 Fuel Station Finder - Express API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "migrate": "node scripts/debug-db.js && sequelize-cli db:migrate",
    "seed": "node src/seed/seedStations.js",
    "seed:admin": "node src/seed/seedAdmin.js",
    "deploy": "npm run migrate && npm run seed && npm run seed:admin && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
